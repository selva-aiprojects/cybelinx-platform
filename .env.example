# =====================================================================
# Cybelinx Central SaaS Platform — environment template
# Copy to .env or export in your shell/CI. Never commit real secrets.
# Defaults below match infra/docker/docker-compose.yml.
# =====================================================================

# Core
NODE_ENV=development
LOG_LEVEL=info

# Control Plane API
API_PORT=3001

# Event Worker
WORKER_PORT=3002
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=50

# Admin Portal (used by the Next.js app; default port 3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# PostgreSQL (local Docker Compose)
# Spring Boot datasource (the Java backend does not read DATABASE_URL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cybelinx_platform
SPRING_DATASOURCE_USERNAME=cybelinx
SPRING_DATASOURCE_PASSWORD=cybelinx_dev_password

# CORS (comma-separated origins allowed for the Control Plane API)
CORS_ORIGINS=http://localhost:3000

# Identity Provider (configured, not hardcoded; swap providers by changing IDP_PROVIDER)
IDP_PROVIDER=supabase
IDP_ISSUER=https://uvddwyfcqdxuvssunuby.supabase.co/auth/v1
IDP_AUDIENCE=authenticated
IDP_JWT_SECRET=
IDP_JWKS_URI=https://uvddwyfcqdxuvssunuby.supabase.co/auth/v1/.well-known/jwks.json
IDP_JWT_CLOCK_SKEW_SECONDS=0


# SUPABASE CONFIG
NEXT_PUBLIC_SUPABASE_URL=https://uvddwyfcqdxuvssunuby.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IovkxVUMzdj9m5eZAfTZSQ_3OySgVjX

SUPABASE_URL=https://uvddwyfcqdxuvssunuby.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IovkxVUMzdj9m5eZAfTZSQ_3OySgVjX
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://uvddwyfcqdxuvssunuby.supabase.co/auth/v1/.well-known/jwks.json

# =====================================================================
# DECOUPLED PRODUCT TARGET DATABASES (LOCAL / VERCEL TESTING)
# Set target database server connection URLs for each product instance.
# Defaults fallback to local PostgreSQL if not specified.
# =====================================================================
PRODUCT_DB_URL_STOREAI_PRODUCTION=jdbc:postgresql://localhost:5432/cybelinx_platform
PRODUCT_DB_URL_STOREAI_DEMO=jdbc:postgresql://localhost:5432/cybelinx_platform
PRODUCT_DB_USER_STOREAI=cybelinx
PRODUCT_DB_PASSWORD_STOREAI=cybelinx_dev_password

PRODUCT_DB_URL_JIOPLIX_PRODUCTION=jdbc:postgresql://localhost:5432/cybelinx_platform
PRODUCT_DB_USER_JIOPLIX=cybelinx
PRODUCT_DB_PASSWORD_JIOPLIX=cybelinx_dev_password

PRODUCT_DB_URL_LIMS_PRODUCTION=jdbc:postgresql://localhost:5432/cybelinx_platform
PRODUCT_DB_USER_LIMS=cybelinx
PRODUCT_DB_PASSWORD_LIMS=cybelinx_dev_password

# Email configurations
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="Cybelinx: Product Onboarding <onboarding@cybelinx.com>"
RESEND_TO=sales@cybelinx.com
