# =====================================================================
# Cybelinx Central SaaS Platform — environment template
# Copy to .env or export in your shell/CI. Never commit real secrets.
# Defaults below match infra/docker/docker-compose.yml.
# =====================================================================

# Core
NODE_ENV=development
LOG_LEVEL=info

# Control Plane API
API_PORT=3001

# Event Worker
WORKER_PORT=3002
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=50

# Admin Portal (used by the Next.js app; default port 3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# PostgreSQL (local Docker Compose)
# Spring Boot datasource (the Java backend does not read DATABASE_URL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cybelinx_platform
SPRING_DATASOURCE_USERNAME=cybelinx
SPRING_DATASOURCE_PASSWORD=cybelinx_dev_password

# CORS (comma-separated origins allowed for the Control Plane API)
CORS_ORIGINS=http://localhost:3000

# Identity Provider (configured, not hardcoded; swap providers by changing IDP_PROVIDER)
# LOCAL DEFAULT: generic + HS256 (no Supabase/Keycloak needed) — first login as
# dev.admin@cybelinx.test / Admin@123 works out of the box after a fresh DB.
IDP_PROVIDER=generic
# Blank issuer/audience/jwks => the JWT verifier does not enforce them locally.
# Point them at your IdP (e.g. Supabase) in production.
IDP_ISSUER=
IDP_AUDIENCE=
IDP_JWT_SECRET=dev-secret-key-for-hs256-signing-only-00
IDP_JWKS_URI=
IDP_JWT_CLOCK_SKEW_SECONDS=0

# Admin Portal email+password login (POST /api/v1/auth/login)
# IDP_PROVIDER=generic + IDP_JWT_SECRET (32+ bytes) to log in as dev.admin@cybelinx.test.
CYBELINX_AUTH_BOOTSTRAP_PASSWORD=Admin@123
CYBELINX_AUTH_TOKEN_TTL_HOURS=24


# SUPABASE CONFIG
NEXT_PUBLIC_SUPABASE_URL=https://uvddwyfcqdxuvssunuby.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IovkxVUMzdj9m5eZAfTZSQ_3OySgVjX

SUPABASE_URL=https://uvddwyfcqdxuvssunuby.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IovkxVUMzdj9m5eZAfTZSQ_3OySgVjX
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://uvddwyfcqdxuvssunuby.supabase.co/auth/v1/.well-known/jwks.json

# =====================================================================
# DECOUPLED PRODUCT TARGET DATABASES (LOCAL / VERCEL TESTING)
