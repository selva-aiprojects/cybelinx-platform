# Defaults fallback to local PostgreSQL if not specified.
# =====================================================================
PRODUCT_DB_URL_STOREAI_PRODUCTION=postgresql://neondb_owner:npg_AEz9RXOcPSp4@ep-blue-water-ahyij9xn-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
PRODUCT_DB_URL_STOREAI_DEMO=postgresql://neondb_owner:npg_AEz9RXOcPSp4@ep-blue-water-ahyij9xn-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
PRODUCT_DB_USER_STOREAI=neondb_owner
PRODUCT_DB_PASSWORD_STOREAI=npg_AEz9RXOcPSp4

PRODUCT_DB_URL_JIOPLIX_PRODUCTION=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
PRODUCT_DB_USER_JIOPLIX=postgres.uvddwyfcqdxuvssunuby
PRODUCT_DB_PASSWORD_JIOPLIX=your_supabase_db_password

PRODUCT_DB_URL_LIMS_PRODUCTION=jdbc:postgresql://lims-db-prod.internal:5432/lims_production
PRODUCT_DB_USER_LIMS=lims_admin
PRODUCT_DB_PASSWORD_LIMS=lims_secure_password

# Email configurations
RESEND_API_KEY=your_resend_api_key_here
